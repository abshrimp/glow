{
  "format_version": "1.8.0",
  "render_controllers": {
    //本体
    "controller.render.touka": {
      "geometry": "Geometry.touka",
      "materials": [ { "*": "Material.touka" } ],
      "textures": [ "Texture.touka" ],
      //0:white 1:red 2:blue 3:yellow 4:green 5:purple 6:lightgreen 7:black
      "overlay_color": {
          "r": 0.0,
          "g": 1.0,
          "b": 1.0,
          "a": 1.0
      },
      "is_hurt_color":{
        "r": 0.0,
        "g": 0.0,
        "b": 0.0,
        "a": 0.0
      },
      "on_fire_color":{
        "r": 0.0,
        "g": 0.0,
        "b": 0.0,
        "a": 0.0
      },
      "light_color_multiplier": 10,
      "ignore_lighting" : true
    },
    /*"controller.render.alpha": {
      "geometry": "Geometry.touka",
      "materials": [ { "*": "Material.default" } ],
      "textures": [ "Texture.touka" ]
    },*/
    "controller.render.emissive": {
      "geometry": "Geometry.touka",
      "materials": [ { "*": "Material.emissive" } ],
      "textures": [ "Texture.touka" ]
    },

    //黒枠
    "controller.render.touka_waku": {
      "geometry": "Geometry.touka_waku",
      "materials": [ { "*": "Material.touka" } ],
      "textures": [ "Texture.touka_waku" ],
      "overlay_color": {
          "r": "0.0",
          "g": "0.0",
          "b": "0.0",
          "a": "1.0"
      },
      "is_hurt_color":{
        "r": 0.0,
        "g": 0.0,
        "b": 0.0,
        "a": 0.0
      },
      "on_fire_color":{
        "r": 0.0,
        "g": 0.0,
        "b": 0.0,
        "a": 0.0
      },
      "light_color_multiplier": 10,
      "ignore_lighting" : true
    },
    "controller.render.emissive_waku": {
      "geometry": "Geometry.touka_waku",
      "materials": [ { "*": "Material.emissive" } ],
      "textures": [ "Texture.touka_waku" ]
    }
  }
}
