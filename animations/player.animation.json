{
	"format_version" : "1.8.0",
	"animations" : {
		"animation.player.touka" : {
			"anim_time_update": "query.distance_from_camera",
			"loop" : true,
			"bones" : {
				"head_touka" : {
					"scale" : "q.is_item_name_any('slot.armor.head',0,'') ? 0.95 : 1.05 "
				},
				"body_touka" : {
					"scale" : "0.9"
				},
				"leftArm_touka" : {
					"position":[0,"q.is_item_name_any('slot.armor.chest',0,'') ? -0.2 : 0.5 ",0],
					"scale" : [
						"q.is_item_name_any('slot.armor.chest',0,'') ? 0.9 : 1.0 ",
						"q.is_item_name_any('slot.armor.chest',0,'') ? 0.9 : 0.95 ",
						"q.is_item_name_any('slot.armor.chest',0,'') ? 0.9 : 1.0 "
					]
				},
				"rightArm_touka" : {
					"position":[0,"q.is_item_name_any('slot.armor.chest',0,'') ? -0.2 : 0.5 ",0],
					"scale" : [
						"q.is_item_name_any('slot.armor.chest',0,'') ? 0.9 : 1.0 ",
						"q.is_item_name_any('slot.armor.chest',0,'') ? 0.9 : 0.95 ",
						"q.is_item_name_any('slot.armor.chest',0,'') ? 0.9 : 1.0 "
					]
				},
				"leftLeg_touka" : {
					"scale" : "( q.is_item_name_any('slot.armor.legs',0,'') && q.is_item_name_any('slot.armor.feet',0,'') ) ? 0.9 : 1.0 "
				},
				"rightLeg_touka" : {
					"scale" : "( q.is_item_name_any('slot.armor.legs',0,'') && q.is_item_name_any('slot.armor.feet',0,'') ) ? 0.9 : 1.0 "
				}
			}
		}
	}
}
